{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["* * 1 * *"],
  "timezone": "America/Denver",
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "description": "Group all eai-* infra package bumps across Pulumi stacks",
      "matchPackagePatterns": ["^eai-"],
      "matchFileNames": ["pulumi/**/pyproject.toml"],
      "groupName": "eai-infra-packages",
      "groupSlug": "eai-infra-packages"
    }
  ]
}
